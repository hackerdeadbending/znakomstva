# Copy into your hosting provider's environment settings.
# Never commit real secrets or a populated .env file.
BOT_TOKEN=
DATABASE_URL=

# Numeric Telegram user IDs are required for secure admin authorization.
# Resolve these from Telegram updates or an authenticated bot command, then configure them here.
OWNER_TELEGRAM_ID=
ADMIN_TELEGRAM_ID=

# Optional future billing configuration; leave unset until a provider is selected.
PAYMENTS_PROVIDER=
PAYMENTS_WEBHOOK_SECRET=
